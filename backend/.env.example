# Strategy: in production (Render, Vercel, etc.), use Resend (HTTP API).
# For local dev, you can use Gmail SMTP if you don't want to bother with Resend.
# If RESEND_API_KEY is set, Resend is used; otherwise SMTP is used.

# --- Production: Resend (recommended) -----------------------------------
RESEND_API_KEY=re_your_api_key_here
ADMIN_EMAIL=fidelity.plus45@gmail.com
# Optional override of the From header. Default: Fidelity Plus <onboarding@resend.dev>.
# Once you verify a domain in Resend, set this to noreply@yourdomain.fr.
# MAIL_FROM=Fidelity Plus <noreply@yourdomain.fr>

# --- Local dev fallback: Gmail SMTP -------------------------------------
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_gmail_app_password
PORT=3000

# CORS allowed origins (comma-separated). Leave empty for "*".
ALLOWED_ORIGINS=
